# =============================================================================
# Wealthly — Configuration
# =============================================================================
# Copie ce fichier en .env et adapte les valeurs.
# Ne JAMAIS committer le fichier .env (il est dans .gitignore).
# Le fichier .env.example, lui, doit être committé pour servir de template.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=wealthly
POSTGRES_PASSWORD=change_me_to_something_strong
POSTGRES_DB=wealthly

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
# IMPORTANT : génère une vraie clé secrète aléatoire avec :
#   openssl rand -hex 32
# (sur Mac/Linux dans un terminal — donne une chaîne de 64 caractères)
# Sur Windows, tu peux utiliser : powershell -Command "[Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
SECRET_KEY=GENERATE_A_REAL_RANDOM_KEY_WITH_OPENSSL_RAND_HEX_32

# Durée du JWT (10080 minutes = 7 jours)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origines autorisées pour CORS (séparées par virgule, sans espace)
# Pour usage local : http://localhost:3000
# Pour usage avec un domaine : https://wealthly.tondomaine.com
CORS_ORIGINS=http://localhost:3000

# Debug (false en production)
DEBUG=false

# -----------------------------------------------------------------------------
# Ports exposés
# -----------------------------------------------------------------------------
# Si 3000 ou 8000 sont déjà pris sur ta machine, change-les ici
FRONTEND_PORT=3000
BACKEND_PORT=8000
