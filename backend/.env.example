# =============================================================================
# Wealthly — Configuration backend (sans Docker)
# =============================================================================
# Copie ce fichier en backend/.env et adapte les valeurs.
# Ne JAMAIS committer backend/.env (il contient ta clé secrète).
# =============================================================================

# -----------------------------------------------------------------------------
# Clé secrète JWT — OBLIGATOIRE, génère une vraie valeur :
#   Mac/Linux : openssl rand -hex 32
#   Windows   : powershell -Command "[Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Durée de session (10080 min = 7 jours)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Base de données
# SQLite (par défaut, aucune installation requise) :
#   DATABASE_URL=sqlite:///./wealthly.db
# PostgreSQL (si tu veux migrer plus tard) :
#   DATABASE_URL=postgresql://user:password@localhost:5432/wealthly
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./wealthly.db

# -----------------------------------------------------------------------------
# CORS — origines autorisées pour le frontend
# En développement local :
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# En production sur un domaine :
# CORS_ORIGINS=https://wealthly.tondomaine.com
# -----------------------------------------------------------------------------

DEBUG=false

# -----------------------------------------------------------------------------
# Clé API Anthropic — optionnelle, pour la catégorisation IA (BYOK)
# Obtenir une clé sur https://console.anthropic.com
# Sans cette clé, la catégorisation fonctionne uniquement par regex.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-api03-...
